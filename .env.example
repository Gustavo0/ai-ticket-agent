# =============================================================================
# AI Ticket Agent API - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# =============================================================================

# --- Aplicação ---
# Nome da aplicação (usado no título da API)
APP_NAME=AI Ticket Agent API

# Versão da API
APP_VERSION=0.2.0

# Descrição exibida na documentação
APP_DESCRIPTION=API de chamados de suporte técnico.

# Prefixo das rotas da API
API_PREFIX=/api/v1

# Modo debug (True/False). Em produção, use False.
DEBUG=False

# --- Servidor ---
# Host onde o servidor irá escutar
HOST=0.0.0.0

# Porta do servidor
PORT=8000

# --- Banco de dados ---
# URL de conexão com o banco de dados.
# Padrão: SQLite em memória (os dados são zerados ao reiniciar).
# Para usar SQLite em arquivo:
#   DATABASE_URL=sqlite:///./app.db
# Para usar PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/ai_ticket_agent
# Para usar MySQL:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_ticket_agent
DATABASE_URL=sqlite://

# Exibir queries SQL no console (True/False)
DB_ECHO=False

# --- CORS ---
# Origens permitidas para CORS (separadas por vírgula).
# Para múltiplas origens:
#   CORS_ORIGINS=["http://localhost:3000","https://app.exemplo.com"]
CORS_ORIGINS=["*"]